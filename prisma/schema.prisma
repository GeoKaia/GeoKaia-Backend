// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Categoria {
  GASTRONOMIA
  CULTURA
  NATURALEZA
  HISTORIA
  ARTESANIA
}

enum Tier {
  GRATIS
  PREMIUM
}

model Lugar {
  id              Int           @id @default(autoincrement())
  nombre          String
  descripcion     String
  categoria       Categoria
  tier            Tier          @default(GRATIS)
  latitud         Float
  longitud        Float
  horarios        String?
  fotoUrl         String?
  panoramaUrl     String?
  videoUrl        String?
  galeriaUrls     String[]
  whatsapp        String?
  menuUrl         String?
  paradas         ParadaRuta[]
  negocio         Negocio?
  createdAt       DateTime      @default(now())
}

model Ruta {
  id                Int          @id @default(autoincrement())
  nombre            String
  categoria         String
  descripcion       String
  descripcionParaIA String
  paradas           ParadaRuta[]
  createdAt         DateTime     @default(now())
}

model ParadaRuta {
  id                 Int    @id @default(autoincrement())
  ruta               Ruta   @relation(fields: [rutaId], references: [id])
  rutaId             Int
  lugar              Lugar  @relation(fields: [lugarId], references: [id])
  lugarId            Int
  orden              Int
  minutosAlSiguiente Int?
}

model Lead {
  id             Int      @id @default(autoincrement())
  nombreNegocio  String
  nombreContacto String
  whatsapp       String
  mensaje        String?
  createdAt      DateTime @default(now())
}

model Negocio {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  passwordHash   String
  nombreContacto String
  whatsapp       String
  totpSecret     String?
  createdAt      DateTime @default(now())
  lugarId        Int?     @unique
  lugar          Lugar?   @relation(fields: [lugarId], references: [id])
}