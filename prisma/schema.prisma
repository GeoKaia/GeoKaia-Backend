// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Categoria {
  GASTRONOMIA
  CULTURA
  NATURALEZA
  HISTORIA
  ARTESANIA
  ALOJAMIENTO
}

enum Tier {
  GRATIS
  PREMIUM
}

enum EstadoLugar {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Lugar {
  id              Int           @id @default(autoincrement())
  nombre          String
  descripcion     String
  categoria       Categoria
  // Etiqueta libre dentro de la categoria (ej. "Catedrales", "Reservas naturales") para la leyenda del mapa.
  // Texto libre a propósito: permite sumar nuevas etiquetas sin otra migración.
  subcategoria    String?
  tier            Tier          @default(GRATIS)
  // Default APROBADO para no esconder los lugares que ya existian antes de este campo.
  // Los lugares que un negocio registra desde el panel se crean en PENDIENTE explicitamente.
  estado          EstadoLugar   @default(APROBADO)
  latitud         Float
  longitud        Float
  horarios        String?
  // Opcionales: si el negocio no las carga, el frontend arma un link genérico a
  // partir de latitud/longitud. Están acá para que puedan pisar ese default con su
  // ficha real de Google Maps o un link de Waze puntual (más preciso que el pin).
  mapsUrl         String?
  wazeUrl         String?
  fotoUrl         String?
  panoramaUrl     String?
  videoUrl        String?
  galeriaUrls     String[]
  whatsapp        String?
  menuUrl         String?
  audioUrl        String?
  paradas         ParadaRuta[]
  negocio         Negocio?
  comentarios     ComentarioAdmin[]
  createdAt       DateTime      @default(now())
}

model Ruta {
  id                Int          @id @default(autoincrement())
  nombre            String
  categoria         String
  descripcion       String
  descripcionParaIA String
  fotoUrl           String?
  emoji             String?
  color             String?
  paradas           ParadaRuta[]
  createdAt         DateTime     @default(now())
}

model ParadaRuta {
  id                 Int    @id @default(autoincrement())
  ruta               Ruta   @relation(fields: [rutaId], references: [id])
  rutaId             Int
  lugar              Lugar  @relation(fields: [lugarId], references: [id])
  lugarId            Int
  orden              Int
  minutosAlSiguiente Int?
  distanciaKm        Float?
}

model Lead {
  id             Int      @id @default(autoincrement())
  nombreNegocio  String
  nombreContacto String
  whatsapp       String
  mensaje        String?
  createdAt      DateTime @default(now())
}

model Negocio {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  passwordHash   String
  nombreContacto String
  whatsapp       String
  totpSecret     String?
  esAdmin        Boolean  @default(false)
  createdAt      DateTime @default(now())
  // Constancia de que el titular aceptó los Términos y la Política de Privacidad al registrarse
  // (Ley 787: consentimiento libre, específico e informado). Quedan en null para las cuentas que
  // se crearon antes de que existiera esta aceptación.
  aceptoTerminosEn DateTime?
  terminosVersion  String?
  lugarId        Int?     @unique
  lugar          Lugar?   @relation(fields: [lugarId], references: [id])
  sesiones       SesionRefresco[]
}

// Nota que el equipo de GeoKaia le deja a un negocio sobre su lugar (qué corregir, por qué se rechazó, etc.).
// Reemplaza a la edición directa del lugar por parte del admin: el negocio es quien corrige lo suyo.
model ComentarioAdmin {
  id         Int      @id @default(autoincrement())
  lugarId    Int
  lugar      Lugar    @relation(fields: [lugarId], references: [id], onDelete: Cascade)
  // Se guarda el correo del admin que lo escribió (viene del JWT firmado) para saber quién dejó cada nota.
  autorEmail String
  texto      String
  createdAt  DateTime @default(now())

  @@index([lugarId])
}

// "Dispositivo" de una sesión iniciada con 2FA. La cookie gk_dispositivo lleva un token aleatorio; aquí solo se guarda su
// hash. Permite renovar la cookie de acceso (8 h) sin repetir el login mientras el dispositivo siga registrado.
// Se borra al cerrar sesión, al vencer o al borrarse la cuenta.
model SesionRefresco {
  id        Int      @id @default(autoincrement())
  negocioId Int
  negocio   Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiraEn  DateTime
  createdAt DateTime @default(now())

  @@index([negocioId])
}

// Historial de auditoría: solo se anexa. La migración instala triggers que rechazan UPDATE, DELETE y TRUNCATE, y
// cada fila encadena el hash de la anterior (ver src/services/auditoria.js). A propósito NO tiene claves foráneas:
// el historial debe sobrevivir al borrado de la cuenta o del negocio al que se refiere.
model Auditoria {
  id                Int      @id @default(autoincrement())
  creadaEn          DateTime @default(now())
  actorId           Int?
  actorEmail        String?
  actorRol          String? // ADMIN | PROPIETARIO | ANONIMO
  accion            String // "dominio.accion", por ejemplo sesion.login_fallido
  recursoTipo       String?
  recursoId         String?
  negocioAfectadoId Int?
  resultado         String // OK | DENEGADO | FALLO
  ip                String?
  userAgent         String?
  detalle           Json?
  hashPrevio        String?
  hash              String

  @@index([accion, creadaEn])
  @@index([actorId])
  @@index([negocioAfectadoId])
}
