# Connection string de PostgreSQL (Neon). Formato:
# postgresql://usuario:password@host/db?sslmode=require&channel_binding=require
DATABASE_URL=

# Secreto para firmar y verificar los JWT de sesión (usá una cadena larga y aleatoria)
JWT_SECRET=

# API Key de Groq (https://console.groq.com), usada por el agente de recomendación de rutas
GROQ_API_KEY=

# Puerto del servidor. Opcional, default 4000
PORT=4000

# Opcional. La cookie de sesión es "Secure" (solo HTTPS) cuando NODE_ENV=production. Poné true/false para forzarlo.
COOKIE_SECURE=

# Opcional. Cantidad de proxies delante del backend (default 1). Con el frontend reenviando /api por rewrites
# (Vercel) o con Nginx delante, poné 2 para que los límites de peticiones cuenten por visitante y no por proxy.
TRUST_PROXY_HOPS=

# Opcional. Dias que dura la cookie de dispositivo (gk_dispositivo). Default 7.
SESION_DIAS=
